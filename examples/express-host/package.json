{
  "name": "@post-sync/example-express-host",
  "version": "0.2.0",
  "private": true,
  "description": "Example: an existing Express backend that adds multi-platform posting with the post-social-media-sync package and its own frontend.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx --conditions=post-sync-source src/server.ts",
    "dev": "tsx watch --conditions=post-sync-source src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "post-social-media-sync": "*"
  }
}
