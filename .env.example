# ─────────────────────────────────────────────────────────────────────────────
#  Post Sync server configuration. Copy to `.env` and fill in what you need.
#  The server reads `.env` from the directory you start it in (the repo root
#  for `npm start` / `npm run dev`).
#  With the dashboard on, only ADMIN_PASSWORD is required to start; each
#  platform turns on once its keys are set. See docs/PLATFORM_SETUP.md for
#  step-by-step instructions.
# ─────────────────────────────────────────────────────────────────────────────

# Password for the dashboard.
ADMIN_PASSWORD=change-me

# The address people (and platforms) use to reach this server, without a trailing slash.
#  - The API lives under <PUBLIC_BASE_URL>/api.
#  - OAuth redirect URIs are built from it: <PUBLIC_BASE_URL>/api/oauth/<connector>/callback
#    (0.1 used <PUBLIC_BASE_URL>/oauth/<connector>/callback: update your developer consoles).
#  - Instagram (photos) and Threads download media from it, so for those it must be
#    reachable from the internet (a real domain, or a tunnel like cloudflared/ngrok).
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data            # SQLite database (post-sync.db), uploaded media and the generated secret live here
# MAX_UPLOAD_MB=4096
# WORKER_CONCURRENCY=3       # how many uploads run at once in this process (always one per account)
# MAX_ATTEMPTS=3             # automatic retries for temporary errors (rate limits, outages)
# LOG_LEVEL=info             # fatal, error, warn, info, debug, trace or silent

# Encrypts stored platform tokens and signs cookies and media URLs. Generated automatically into
# DATA_DIR/.app-secret if unset. If you set it yourself, use 32+ random characters and never change it
# afterwards (changing it means reconnecting every account). Several servers must share the same value.
# APP_SECRET=

# ── Mode ────────────────────────────────────────────────────────────────────
# on  = web dashboard with password login, plus the API under /api.
# off = headless: only the HTTP API under /api, for your own backend and frontend. Needs API_TOKEN.
# DASHBOARD=on

# Token for backends and scripts (16+ characters): send `Authorization: Bearer <API_TOKEN>` to /api/*.
# Add an `X-Owner-Id: <your user or workspace id>` header to act for one of your users: each owner has
# their own accounts, media and posts. Without it, requests act for the dashboard's owner ("default").
# The token can act for every owner: keep it on your servers, never in a browser.
# API_TOKEN=

# ── Database and scaling ────────────────────────────────────────────────────
# PostgreSQL connection string. Default: SQLite at DATA_DIR/post-sync.db (fine for one server).
# Use PostgreSQL to run several servers against the same data (they also need the same APP_SECRET
# and a shared DATA_DIR for uploaded media).
# DATABASE_URL=postgres://user:password@localhost:5432/postsync
# Publish queued posts in this process. Set to off on extra API-only servers (needs DATABASE_URL;
# at least one server must keep it on).
# WORKER=on

# ── Webhooks (optional) ─────────────────────────────────────────────────────
# POST each event (post published, failed, account needs reconnecting, …) as JSON to this URL.
# WEBHOOK_URL=https://app.example.com/hooks/post-sync
# Signs each delivery: X-Post-Sync-Signature: sha256=HMAC-SHA256(secret, "<X-Post-Sync-Timestamp>.<body>").
# WEBHOOK_SECRET=
# Events to send, comma-separated. Default: all except target.progress. Available: post.created,
# target.started, target.progress, target.succeeded, target.failed, target.cancelled,
# account.connected, account.disconnected, account.needsReconnect
# WEBHOOK_EVENTS=target.succeeded,target.failed,account.needsReconnect

# ── Your own frontend (optional) ────────────────────────────────────────────
# Origins (besides PUBLIC_BASE_URL) that `returnTo` may send the browser back to after connecting an account.
# ALLOWED_RETURN_ORIGINS=https://app.example.com
# Frontends on other origins allowed to call the API from the browser (with credentials).
# CORS_ORIGINS=https://app.example.com
# Hosts POST /api/media/from-url may download from, e.g. your bucket. Empty = that endpoint is off.
# REMOTE_MEDIA_HOSTS=my-bucket.s3.amazonaws.com

# ── Facebook Pages + Instagram (one Meta app) ───────────────────────────────
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# For "Facebook Login for Business" apps, the configuration ID to use instead of scopes:
# META_LOGIN_CONFIG_ID=
# Extra permissions to request. Use ads_read if your Page role comes from Business Manager (needed for Instagram):
# META_EXTRA_SCOPES=ads_read

# ── Threads (Meta app with the Threads use case) ────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── TikTok ──────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Remove video.publish if your app only has "upload to inbox" access:
# TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# ── YouTube (Google Cloud OAuth client) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LinkedIn ────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Also post as Company Pages you administer (needs the Community Management API product):
# LINKEDIN_ORGANIZATIONS=true
# Pin an API version (YYYYMM). By default the newest active version is detected automatically.
# LINKEDIN_VERSION=

# ── X / Twitter (OAuth 2.0 client) ──────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=

# Bluesky needs no keys: connect it in the dashboard with an app password.
