# ─────────────────────────────────────────────────────────────────────────────
#  Post Sync configuration. Copy to `.env` and fill in what you need.
#  Only ADMIN_PASSWORD is required to start; each platform turns on once its
#  keys are set. See docs/PLATFORM_SETUP.md for step-by-step instructions.
# ─────────────────────────────────────────────────────────────────────────────

# Password for the dashboard.
ADMIN_PASSWORD=change-me

# The address people (and platforms) use to reach this server, without a trailing slash.
#  - OAuth redirect URIs are built from it: <PUBLIC_BASE_URL>/oauth/<platform>/callback
#  - Instagram (photos) and Threads download media from it, so for those it must be
#    reachable from the internet (a real domain, or a tunnel like cloudflared/ngrok).
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data            # database + uploaded media live here
# MAX_UPLOAD_MB=4096
# WORKER_CONCURRENCY=3       # how many uploads run at once (always one per account)
# MAX_ATTEMPTS=3             # automatic retries for temporary errors (rate limits, outages)

# Encrypts stored platform tokens. Generated automatically into DATA_DIR/.app-secret if unset.
# If you set it yourself, use 32+ random characters and never change it afterwards.
# APP_SECRET=

# Optional token for scripts: send `Authorization: Bearer <API_TOKEN>` to /api/*.
# API_TOKEN=

# ── Facebook Pages + Instagram (one Meta app) ───────────────────────────────
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# For "Facebook Login for Business" apps, the configuration ID to use instead of scopes:
# META_LOGIN_CONFIG_ID=
# Extra permissions to request. Use ads_read if your Page role comes from Business Manager (needed for Instagram):
# META_EXTRA_SCOPES=ads_read

# ── Threads (Meta app with the Threads use case) ────────────────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── TikTok ──────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Remove video.publish if your app only has "upload to inbox" access:
# TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# ── YouTube (Google Cloud OAuth client) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LinkedIn ────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Also post as Company Pages you administer (needs the Community Management API product):
# LINKEDIN_ORGANIZATIONS=true
# Pin an API version (YYYYMM). By default the newest active version is detected automatically.
# LINKEDIN_VERSION=

# ── X / Twitter (OAuth 2.0 client) ──────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=

# Bluesky needs no keys: connect it in the dashboard with an app password.
